# ---------------------------------------------------------------------------
# RLWM CMIS environment configuration. Copy to `.env` and fill in real values.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# Django
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=change-me-to-at-least-50-random-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=cmis.example.org
CSRF_TRUSTED_ORIGINS=https://cmis.example.org
FRONTEND_URL=https://cmis.example.org
# Only needed if the frontend is served from a different origin than the API
CORS_ALLOWED_ORIGINS=

# Domain used by Caddy to obtain the HTTPS certificate automatically
CMIS_DOMAIN=cmis.example.org

# PostgreSQL
POSTGRES_DB=cmis
POSTGRES_USER=cmis
POSTGRES_PASSWORD=change-me-strong-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Authentication
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_TOKEN_HOURS=2

# Email (password resets & notifications). Console backend prints emails to the log.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=RLWM CMIS <no-reply@example.org>

# Uploads
MAX_UPLOAD_MB=10

# Backups (see docs/BACKUP_AND_RESTORE.md)
BACKUP_KEEP_DAYS=30

# Logging
LOG_LEVEL=INFO

# Set to false only for a plain-HTTP local trial (CMIS_DOMAIN=:80)
SECURE_SSL_REDIRECT=true

# Uploaded files are served through signed links valid for this many seconds
FILE_URL_MAX_AGE=3600

# Retention (purge_expired, run daily by the housekeeping container)
IDEMPOTENCY_KEEP_DAYS=30
NOTIFICATION_KEEP_DAYS=180

# Backups: host folder and hour (UTC) of the nightly run
BACKUP_DIR=./backups
BACKUP_HOUR=02

# Show /api/docs and /api/schema without signing in to /django-admin (default false)
API_DOCS_PUBLIC=false

# ---------------------------------------------------------------------------
# Vercel + Supabase only (docs/DEPLOY_VERCEL_SUPABASE.md). Leave unset for Docker.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
# DB_POOLER=transaction
# DB_SSLMODE=require
# FILE_STORAGE=s3
# S3_ENDPOINT_URL=https://<ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=eu-west-2
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_MEDIA=cmis-media
# S3_BUCKET_PRIVATE=cmis-documents
# CACHE_BACKEND=database
# STATIC_MANIFEST=false
# CRON_SECRET=
# MAX_UPLOAD_MB=4
