# RLWM CMIS web server. CMIS_DOMAIN comes from .env; Caddy obtains and renews the
# HTTPS certificate automatically. Set CMIS_DOMAIN=:80 for a plain-HTTP local trial.
{$CMIS_DOMAIN:localhost} {
	encode zstd gzip

	# Uploads: keep in step with MAX_UPLOAD_MB (plus room for form fields).
	request_body {
		max_size 25MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://*.tile.openstreetmap.org; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' blob:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Camera and microphone stay off, except on the media pages (live camera / HDMI capture feed).
	# Those pages are served from their own copy of the app shell, presentation.html.
	@media_pages path /presentation /presentation/* /presentation.html
	@other_pages not path /presentation /presentation/* /presentation.html
	header @other_pages Permissions-Policy "camera=(), microphone=(), geolocation=()"
	header @media_pages Permissions-Policy "camera=(self), microphone=(self), geolocation=()"

	# API, Django admin and its static files go to the Django application.
	# Uploaded files are never served from disk here: the API streams them after checking a signed link.
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /django-admin/* {
		reverse_proxy api:8000
	}
	handle /static/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		# The service worker and app shell must always be re-validated so updates reach devices.
		@nocache path /sw.js /index.html /presentation.html /manifest.webmanifest /registerSW.js
		header @nocache Cache-Control "no-cache"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@presentation path /presentation /presentation/*
		rewrite @presentation /presentation.html
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
